{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "coreutils",
  "kind": "application",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "packages": [
    "hyper-cat",
    "hyper-chmod",
    "hyper-cp",
    "hyper-echo",
    "hyper-ln",
    "hyper-ls",
    "hyper-mkdir",
    "hyper-mv",
    "hyper-rm",
    "hyper-rmdir",
    "hyper-touch"
  ],
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-cat"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-chmod"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-cp"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-echo"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-ln"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-ls"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-mkdir"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-mv"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-rm"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-rmdir"
    ],
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-touch"
    ]
  ],
  "cargo": [
    {
      "manifest": "cat/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "chmod/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "cp/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "echo/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "ln/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "ls/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "mkdir/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "mv/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "rm/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "rmdir/Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "touch/Cargo.toml",
      "domain": "system"
    }
  ],
  "artifacts": [
    {
      "binary": "hyper-cat",
      "staged": "cat",
      "destination": "bin/cat",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "cat/Cargo.toml",
      "enabled": true
    },
    {
      "binary": "hyper-chmod",
      "staged": "chmod",
      "destination": "bin/chmod",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "chmod/Cargo.toml",
      "enabled": true
    },
    {
      "binary": "hyper-cp",
      "staged": "cp",
