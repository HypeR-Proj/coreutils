  "build": {
    "requires": [
      "toolchain"
    ],
    "actions": {
      "all": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ],
      "build": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ],
      "check": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ]
    }
  }
}
