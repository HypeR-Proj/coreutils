      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "ls/Cargo.toml",
      "enabled": true
    },
    {
      "binary": "hyper-mkdir",
      "staged": "mkdir",
      "destination": "bin/mkdir",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "mkdir/Cargo.toml",
      "enabled": true
